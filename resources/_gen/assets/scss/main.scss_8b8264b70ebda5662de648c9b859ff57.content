ext);text-decoration:none}.site-footer__logo{width:48px;height:48px;object-fit:contain;border-radius:12px;filter:drop-shadow(0 6px 16px rgba(191,0,31,.18))}.site-footer__title{font-size:1.1rem;font-weight:800;letter-spacing:-.015em;margin:0}.site-footer__subtitle{font-size:.95rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;margin:0}.site-footer__links{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem}.site-footer__links a{color:var(--text-secondary);font-size:.9rem}.site-footer__links a:hover{color:var(--accent)}.site-footer__socials{display:flex;gap:.75rem}.site-footer__socials a{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:var(--radius-full);background:var(--surface);border:1px solid var(--border);color:var(--text)}.site-footer__socials a svg{width:18px;height:18px;stroke-width:2;fill:none}.site-footer__socials a:hover{border-color:var(--accent);color:var(--accent)}.site-footer__bottom{display:grid;gap:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border)}@media(min-width:768px){.site-footer__bottom{grid-template-columns:1fr 1fr;align-items:center}}.site-footer__newsletter{display:flex;flex-direction:column;gap:.5rem}.site-footer__newsletter label{font-size:.9rem;font-weight:600}.site-footer__copyright{color:var(--text-secondary);font-size:.85rem;text-align:right}@media(max-width:767px){.site-footer__copyright{text-align:left}}.footer-langs a{margin-right:.35rem;font-weight:600;font-size:.76rem;letter-spacing:.07em;text-transform:uppercase;border-radius:var(--radius-full);padding:.2rem .45rem}.footer-langs a[aria-current=page]{background:color-mix(in srgb,var(--accent) 14%,transparent);color:var(--accent)}.breadcrumbs{padding:.8rem 1rem;border-radius:var(--radius-full);font-size:.85rem;display:inline-block}.breadcrumbs a{color:var(--accent-secondary);margin:0 .25rem}.breadcrumbs a:after{content:'/';margin:0 .5rem}.breadcrumbs a:last-child:after{display:none